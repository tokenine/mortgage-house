# Feature toggles for Mortgage House frontend
# Copy to .env and adjust values as needed.

# Enable creating BUY orders in marketplace modal
# Set to 'true' to allow users to submit buy orders
# Set to 'false' to disable buy order creation (UI will show message)
NEXT_PUBLIC_MARKETPLACE_ENABLE_CREATE_BUY_ORDER=false

# Enable claim rewards functionality on dashboard
# Set to 'true' to allow users to claim their rewards/yields
# Set to 'false' to disable claim rewards button (UI will show "coming soon" message)
NEXT_PUBLIC_ENABLE_CLAIM_REWARDS=false
