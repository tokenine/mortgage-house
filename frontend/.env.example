# WalletConnect Project ID (required)
# Get this from https://cloud.walletconnect.com/
WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# App Configuration
APP_URL=http://localhost:3000
NODE_ENV=development

# Blockchain Network Configuration
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-infura-key
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/your-infura-key

# Optional: Additional RPC URLs for better performance
ETHEREUM_RPC_URL_2=https://eth.llamarpc.com
POLYGON_RPC_URL_2=https://polygon.llamarpc.com

# Development/Test Networks
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-infura-key
MUMBAI_RPC_URL=https://mumbai.infura.io/v3/your-infura-key